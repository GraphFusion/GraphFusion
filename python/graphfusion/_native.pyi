from os import PathLike
from typing import Any

class GraphFusionError(Exception): ...
class Database:
    def __init__(self, path: str | PathLike[str] | None = None, *, create: bool = False) -> None: ...
    def session(self) -> Session: ...
    def checkpoint(self) -> None: ...
    def close(self) -> None: ...
class Session:
    def run(self, gql: str) -> list[PyResultSet]: ...
    def query(self, gql: str) -> PyResultSet: ...
    def set_parameter(self, name: str, value: Any) -> None: ...
    def set_query_limits(self, max_path_hops: int, memory_limit_bytes: int) -> None: ...
    def close(self) -> None: ...
class PyResultSet:
    @property
    def kind(self) -> str: ...
    @property
    def commit_seq(self) -> int: ...
    @property
    def affected(self) -> int: ...
    @property
    def transaction_pending(self) -> bool: ...
    def arrow_ipc(self) -> bytes | None: ...
