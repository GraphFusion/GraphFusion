---
import SiteTitle from '@astrojs/starlight/components/SiteTitle.astro';
---

<div class="header-brand">
  <SiteTitle />
  <a class="playground-link print:hidden" href="/playground/">Playground</a>
</div>

<style>
  .header-brand {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }

  .playground-link {
    flex-shrink: 0;
    border: 1px solid var(--sl-color-accent);
    border-radius: 0.5rem;
    padding: 0.375rem 0.625rem;
    background: var(--sl-color-accent-low);
    color: var(--sl-color-accent-high);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    text-decoration: none;
    white-space: nowrap;
  }

  .playground-link:hover {
    background: var(--sl-color-accent-high);
    color: var(--sl-color-accent-low);
  }

  @media (max-width: 49.999rem) {
    .header-brand { gap: 0.75rem; }
    .header-brand :global(.site-title) { font-size: 1rem; gap: 0.375rem; }
    .header-brand :global(.site-title img) { width: 1.5rem; height: 1.5rem; }
  }

  @media (max-width: 22rem) {
    /* Keep the home link's accessible name while making room for search and the menu. */
    .header-brand :global(.site-title span) {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
